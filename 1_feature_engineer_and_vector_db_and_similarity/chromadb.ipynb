   "id": "feature_eng",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Creating product features...\n",
      "Unique products : 500,000\n",
      "Unique users    : 286,431\n"
     ]
    }
