    "HNSW_CONFIGS = {\n",
    "    'LOW':    {'M': 8,  'ef_construction': 50,  'ef_search': 32},\n",
    "    'MEDIUM': {'M': 16, 'ef_construction': 100, 'ef_search': 64},\n",
    "    'HIGH':   {'M': 32, 'ef_construction': 200, 'ef_search': 128},\n",
    "}\n",
    "\n",
    "chroma_client = connect_chromadb()\n",
    "\n",
    "\n",
    "def create_collection(client, name, hnsw_config):\n",
    "    \"\"\"Create ChromaDB collection with HNSW settings.\"\"\"\n",
    "    try:\n",
    "        client.delete_collection(name=name)\n",
    "    except:\n",
    "        pass\n",
    "    return client.create_collection(\n",
    "        name=name,\n",
    "        metadata={\n",
    "            \"hnsw:space\"          : \"ip\",\n",
    "            \"hnsw:M\"              : hnsw_config['M'],\n",
    "            \"hnsw:construction_ef\": hnsw_config['ef_construction'],\n",
    "            \"hnsw:search_ef\"      : hnsw_config['ef_search'],\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "def load_into_chromadb(collection, ids, embeddings, metadatas, batch_size=500):\n",
    "    \"\"\"Load embeddings into ChromaDB in batches.\"\"\"\n",
    "    total = len(ids)\n",
    "    for start in range(0, total, batch_size):\n",
    "        end = min(start + batch_size, total)\n",
    "        collection.add(\n",
    "            ids=ids[start:end],\n",
    "            embeddings=embeddings[start:end].tolist(),\n",
    "            metadatas=metadatas[start:end]\n",
    "        )\n",
    "    print(f\"  Loaded {total:,} vectors\")\n",
    "\n",
    "\n",
    "def ann_search(collection, query_embedding, ef_search, n=11):\n",
    "    \"\"\"\n",
    "    Approximate Nearest Neighbour search using HNSW , where n=11 because we exclude the query vector itself (search finds itself too).\n",
    "     then returns top-10 IDs (excluding self) and time in seconds.\n",
    "    \"\"\"\n",
    "    # Update ef_search for this query\n",
    "    start = time.time()\n",
    "    results = collection.query(\n",
    "        query_embeddings=[query_embedding.tolist()],\n",
    "        n_results=n\n",
    "    )\n",
    "    elapsed = time.time() - start\n",
    "\n",
    "    ids = results['ids'][0]  # includes self\n",
    "    # Remove the query vector itself (closest match = itself)\n",
    "    ids = ids[1:11]  \n",
    "    # take 10 after removing self\n",
    "    return ids, elapsed\n",
    "\n",
    "\n",
    "def enn_search(collection, query_embedding, n=11):\n",
    "    \"\"\"\n",
    "    Exact Nearest Neighbour search — brute force, no HNSW. ChromaDB does exact search when we create a flat collection (no HNSW metadata).\n",
    "    Returns top-10 IDs (excluding self) and time in seconds.\n",
    "    \"\"\"\n",
    "    start = time.time()\n",
    "    results = collection.query(\n",
    "        query_embeddings=[query_embedding.tolist()],\n",
    "        n_results=n\n",
    "    )\n",
    "    elapsed = time.time() - start\n",
    "\n",
    "    ids = results['ids'][0]\n",
    "    ids = ids[1:11]\n",
    "    return ids, elapsed\n",
    "\n",
    "\n",
    "def precision_at_10(exact_ids, approx_ids):\n",
    "    # How many of ANN top-10 match ENN top-10.\n",
    "    return len(set(exact_ids[:10]) & set(approx_ids[:10])) / 10.0\n",
    "\n",
    "\n",
    "def mean_std_report(values):\n",
    "    # Return mean ± 2*std string.\n",
    "    m = np.mean(values)\n",
    "    s = np.std(values)\n",
    "    return f\"{m:.4f} ± {2*s:.4f}\"\n",
    "\n",
    "\n",
    "print(\"Helpers ready\")"
   ]
  },
