   "source": [
    "# Products\n",
    "def create_product_text(row):\n",
    "    text_parts = []\n",
    "    if pd.notna(row['title']) and row['title']:\n",
    "        text_parts.append((row['title'] + \" \") * 1 + row['title'])\n",
    "    if pd.notna(row['description']) and row['description']:\n",
    "        text_parts.append(str(row['description']))\n",
    "    if pd.notna(row['features']) and row['features']:\n",
    "        text_parts.append(str(row['features']))\n",
    "    if pd.notna(row['main_category']) and row['main_category']:\n",
    "        text_parts.append((row['main_category'] + \" \") * 2 + row['main_category'])\n",
    "    if pd.notna(row['details']) and row['details']:\n",
    "        text_parts.append(str(row['details']))\n",
    "    return ' '.join(text_parts) if text_parts else str(row.get('title', 'unknown'))\n",
    "\n",
    "print(\"Creating product features\")\n",
    "products_df['combined_text'] = products_df.apply(create_product_text, axis=1)\n",
    "products_df = products_df.drop_duplicates(subset='parent_asin').reset_index(drop=True)\n",
    "print(f\"Unique products : {len(products_df):,}\")\n",
    "\n",
    "# Users\n",
    "reviews_df['full_review'] = (\n",
    "    reviews_df['title'].fillna('') + ' ' +\n",
    "    reviews_df['text'].fillna('')\n",
    ")\n",
    "user_reviews = (\n",
    "    reviews_df\n",
    "    .groupby('user_id')['full_review']\n",
    "    .apply(' '.join)\n",
    "    .reset_index(name='all_reviews_text')\n",
    ")\n",
    "print(f\"Unique users : {len(user_reviews):,}\")"
   ]
  },
